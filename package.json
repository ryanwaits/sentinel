{
  "name": "audit-sentinel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Continuous Stacks asset-safety audit pipeline — a separate project powered by secondlayer (public SDK + hosted Index/Subgraphs/Streams/Subscriptions).",
  "scripts": {
    "poc:finding-1": "bun run simnet/poc/finding-1.ts",
    "typecheck": "tsc --noEmit",
    "test": "SENTINEL_SINK_DIR=$(mktemp -d) bun test monitoring/ webhooks/ engine/ deploy/",
    "audit": "bun run engine/run.ts",
    "discover": "bun run engine/discover.ts",
    "distill": "bun run engine/distill.ts",
    "baseline": "bun run monitoring/baseline.ts",
    "invariant": "bun run monitoring/invariant.ts",
    "scheduler": "bun run monitoring/scheduler.ts",
    "pox5:config": "bun run monitoring/pox5-bond-ops.ts",
    "lint": "biome check agent engine monitoring webhooks simnet subgraphs",
    "format": "biome check --write agent engine monitoring webhooks simnet subgraphs",
    "sandbox:build": "docker build -t audit-sentinel-simnet:local simnet",
    "sandbox:run": "docker run --rm --network none audit-sentinel-simnet:local",
    "webhook": "bun run webhooks/secondlayer-webhook.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.195",
    "@secondlayer/sdk": "^6.25.1",
    "@secondlayer/stacks": "^2.11.0",
    "@secondlayer/subgraphs": "^3.16.0",
    "@stacks/clarinet-sdk": "^3.22.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.2"
  }
}
